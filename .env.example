# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB (permanent records)
MONGO_URI=mongodb://127.0.0.1:27017/student_safety

# Redis (latest location cache)
REDIS_URL=redis://127.0.0.1:6379
LOCATION_TTL_SECONDS=300

# Comma-separated list of allowed origins, or * for development only
CORS_ORIGINS=*

# Auth-ready: if API_KEY is set, every /api request must send header  x-api-key: <value>
# Leave empty to disable during early development.
API_KEY=

# Only save a location to MongoDB if the student moved at least this many metres,
# or this many seconds passed, or risk is not NORMAL.
SAVE_MIN_DISTANCE_METERS=50
SAVE_MIN_INTERVAL_SECONDS=300

# Do not create a new risk alert for the same student more often than this
ALERT_COOLDOWN_SECONDS=120
